ADMIN_USERNAME=database-manager
# Generate with: npm run hash-password -- "a-long-password"
ADMIN_PASSWORD_HASH=replace-me
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-me
BACKUP_STORAGE=local
# Five-field cron, e.g. 30 2 * * * for daily at 02:30
BACKUP_CRON=
# Target UUID from data/vault.json after adding a target
CRON_TARGET_ID=
# Required only when BACKUP_STORAGE=s3
S3_BUCKET=
S3_REGION=
S3_PREFIX=vaultmanager
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
