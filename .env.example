ADMIN_USERNAME=database-manager
# Used only when the database has no admin account yet; change passwords in the UI afterwards.
ADMIN_INITIAL_PASSWORD=
CONTROL_DB_PASSWORD=replace-with-a-long-random-password
# Base64 of the complete bcrypt or scrypt hash; this avoids Compose parsing '$'.
ADMIN_PASSWORD_HASH_B64=replace-me
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-me
BACKUP_STORAGE=local
# Five-field cron, e.g. 30 2 * * * for daily at 02:30
BACKUP_CRON=
# Deprecated compatibility variable; schedules are now stored per backup job in PostgreSQL
CRON_TARGET_ID=
# 0 disables automatic cleanup; otherwise retain this many successful runs per target
RETENTION_COUNT=0
# Required only when BACKUP_STORAGE=s3
S3_BUCKET=
S3_REGION=
S3_PREFIX=vaultmanager
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional webhook notification endpoint; keep this only in Coolify secrets
NOTIFY_WEBHOOK_URL=
VAULTMANAGER_URL=https://your-vaultmanager-domain.example
